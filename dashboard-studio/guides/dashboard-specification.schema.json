{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dashboard Studio specification",
  "type": "object",
  "required": [
    "schemaVersion",
    "title",
    "theme",
    "source",
    "blocks",
    "canvas"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "2.3"
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "subtitle": {
      "type": "string",
      "maxLength": 800
    },
    "theme": {
      "const": "erm-classic-v0.1"
    },
    "source": {
      "type": "object",
      "required": [
        "reference",
        "schema"
      ],
      "additionalProperties": false,
      "properties": {
        "reference": {
          "type": "string",
          "maxLength": 1000
        },
        "schema": {
          "type": "array",
          "maxItems": 150,
          "items": {
            "type": "object",
            "required": [
              "name",
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 200
              },
              "type": {
                "enum": [
                  "string",
                  "number"
                ]
              },
              "missing": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "blocks": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "title",
          "xPos",
          "yPos",
          "w",
          "h"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 400
          },
          "x": {
            "type": "string",
            "maxLength": 400
          },
          "y": {
            "type": "string",
            "maxLength": 400
          },
          "series": {
            "type": "string",
            "maxLength": 400
          },
          "field": {
            "type": "string",
            "maxLength": 400
          },
          "text": {
            "type": "string",
            "maxLength": 12000
          },
          "note": {
            "type": "string",
            "maxLength": 400
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "type": {
            "enum": [
              "bar",
              "line",
              "area",
              "pie",
              "scatter",
              "heatmap",
              "treemap",
              "map",
              "dropdown",
              "slider",
              "buttons",
              "reset",
              "metric",
              "table",
              "text",
              "radar",
              "clusteredBar",
              "stackedBar",
              "percentBar",
              "donut",
              "bubble",
              "histogram",
              "boxplot",
              "highcharts"
            ]
          },
          "aggregate": {
            "enum": [
              "sum",
              "count",
              "mean"
            ]
          },
          "xPos": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3840
          },
          "yPos": {
            "type": "integer",
            "minimum": 0,
            "maximum": 12000
          },
          "w": {
            "type": "integer",
            "minimum": 100,
            "maximum": 3840
          },
          "h": {
            "type": "integer",
            "minimum": 80,
            "maximum": 12000
          },
          "instructions": {
            "type": "string",
            "maxLength": 12000
          },
          "z": {
            "type": "string",
            "maxLength": 400
          },
          "orientation": {
            "enum": [
              "horizontal",
              "vertical"
            ],
            "default": "horizontal"
          },
          "pageId": {
            "type": "string",
            "maxLength": 80
          },
          "hcType": {
            "enum": [
              "funnel3d",
              "pyramid3d",
              "scatter3d",
              "apo",
              "abands",
              "ad",
              "arcdiagram",
              "area",
              "arearange",
              "areaspline",
              "areasplinerange",
              "aroon",
              "aroonoscillator",
              "atr",
              "ao",
              "bar",
              "bellcurve",
              "bb",
              "boxplot",
              "bubble",
              "bullet",
              "candlestick",
              "cci",
              "chaikin",
              "cmf",
              "cmo",
              "column",
              "columnpyramid",
              "columnrange",
              "cylinder",
              "dema",
              "dependencywheel",
              "disparityindex",
              "dmi",
              "dotplot",
              "dpo",
              "dumbbell",
              "ema",
              "errorbar",
              "flags",
              "flowmap",
              "funnel",
              "gantt",
              "gauge",
              "geoheatmap",
              "heatmap",
              "heikinashi",
              "histogram",
              "hlc",
              "hollowcandlestick",
              "ikh",
              "item",
              "keltnerchannels",
              "klinger",
              "line",
              "linearRegression",
              "linearRegressionAngle",
              "linearRegressionIntercept",
              "linearRegressionSlope",
              "lollipop",
              "macd",
              "map",
              "mapbubble",
              "mapline",
              "mappoint",
              "mfi",
              "momentum",
              "natr",
              "networkgraph",
              "obv",
              "ohlc",
              "organization",
              "packedbubble",
              "pareto",
              "pictorial",
              "pie",
              "pivotpoints",
              "pointandfigure",
              "polygon",
              "ppo",
              "pc",
              "priceenvelopes",
              "psar",
              "pyramid",
              "renko",
              "roc",
              "rsi",
              "sankey",
              "scatter",
              "slowstochastic",
              "sma",
              "solidgauge",
              "spline",
              "stochastic",
              "streamgraph",
              "sunburst",
              "supertrend",
              "tema",
              "tilemap",
              "tiledwebmap",
              "timeline",
              "treegraph",
              "treemap",
              "trendline",
              "trix",
              "variablepie",
              "variwide",
              "vector",
              "venn",
              "vbp",
              "vwap",
              "waterfall",
              "williamsr",
              "windbarb",
              "wma",
              "wordcloud",
              "xrange",
              "zigzag"
            ]
          },
          "mappings": {
            "type": "object",
            "maxProperties": 20,
            "additionalProperties": {
              "type": "string",
              "maxLength": 400
            }
          },
          "period": {
            "type": "integer",
            "minimum": 2,
            "maximum": 500
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 12000
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "snap"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 320,
          "maximum": 3840
        },
        "height": {
          "type": "integer",
          "minimum": 240,
          "maximum": 12000
        },
        "snap": {
          "const": 10
        }
      }
    },
    "data": {
      "type": "array",
      "maxItems": 50000,
      "items": {
        "type": "object",
        "maxProperties": 150,
        "additionalProperties": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        }
      }
    },
    "tabbed": {
      "type": "boolean"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "title": {
            "type": "string",
            "maxLength": 100
          }
        }
      }
    }
  },
  "$comment": "Version 2.3 supports up to three pages, a complete Highcharts 12.4.0 series catalogue, and warning-only HTML exports. Earlier versions migrate to page-1."
}
